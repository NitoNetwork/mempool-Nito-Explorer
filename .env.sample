# ============================================================
# Nito Mempool's Explorer - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values to your setup.

# --- MariaDB ---
# Generate independent high-entropy passwords; do not reuse these placeholders.
MARIADB_ROOT_PASSWORD=changeme_root
MARIADB_DATABASE=mempool_nito
MARIADB_USER=mempool
MARIADB_PASSWORD=changeme_db

# --- Network (mainnet; use regtest only for isolated local QA) ---
NITO_NETWORK=mainnet
# Output of scripts/build-orchard.py on the target Linux architecture.
NITO_ORCHARD_BUILD_DIR=/absolute/path/to/nito-orchard-build

# --- Nito Core (nitod) RPC ---
# Your running nitod instance (must be accessible from backend and ElectrumX).
# Generate a dedicated RPC password; arbitrary characters are safely encoded.
CORE_RPC_HOST=host.docker.internal
CORE_RPC_PORT=8825
CORE_RPC_USERNAME=your_rpc_user
CORE_RPC_PASSWORD=your_rpc_password

# --- Nito ElectrumX ---
ELECTRUMX_PORT=51001
ELECTRUMX_CACHE_MB=512
ELECTRUMX_LOG_LEVEL=info

# Number of recent blocks retained in the explorer statistics database.
# This does not limit ElectrumX: ElectrumX always indexes the complete chain.
MEMPOOL_INDEXING_BLOCKS_AMOUNT=11000

# --- Domain & SSL ---
DOMAIN=explorer.example.com
SSL_CERT_PATH=/etc/letsencrypt/live/explorer.example.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/explorer.example.com/privkey.pem

# --- Ports ---
FRONTEND_PORT=443
HTTP_PORT=80
FRONTEND_BIND=0.0.0.0
BACKEND_PORT=8999
MARIADB_PORT=3306

# No Bitcoin price provider is a source of NITO exchange rates.
FIAT_PRICE_ENABLED=false
# Optional explicit image tags for deployment/rollback provenance.
ELECTRUMX_IMAGE=nito-mempool-electrumx:local
BACKEND_IMAGE=nito-mempool-backend:local
FRONTEND_IMAGE=nito-mempool-frontend:local
